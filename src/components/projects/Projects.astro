---
import { data } from "@/data/projects.js";

const allProjects = data.projects;
const featuredProjects = allProjects.slice(0, 3);
const olderProjects = allProjects.slice(3);
---

<section id="projects" class="py-20 relative z-10 px-6 font-sans">
  <div class="max-w-7xl mx-auto">
    
    <!-- Cabecera de sección -->
    <div class="animate-on-scroll text-center mb-16">
      <div class="inline-block font-mono text-xs text-cyan-400 bg-cyan-500/10 border border-cyan-500/20 px-3 py-1 rounded-full mb-4">
        $ ls -la ./projects/
      </div>
      <h2 class="text-4xl md:text-5xl font-bold mb-6 text-white tracking-tight">
        Proyectos Destacados
      </h2>
      <div class="w-24 h-1 bg-gradient-to-r from-purple-400 to-cyan-400 mx-auto mb-6"></div>
      <p class="text-lg text-white/70 max-w-2xl mx-auto font-mono text-sm">
        // Arquitecturas SaaS, aplicaciones web de alto rendimiento e integración offline-first.
      </p>
    </div>

    <!-- Contenedor general -->
    <div class="space-y-8">
      
      <!-- Primeros 3 proyectos (Siempre visibles) -->
      <div class="grid lg:grid-cols-3 gap-8">
        {
          featuredProjects.map((project, index) => (
            <div class="animate-on-scroll flex" style={`animation-delay: ${index * 0.15}s;`}>
              <div class="relative group hover:-translate-y-2 transition-all duration-500 overflow-hidden rounded-xl bg-[#09090B] border border-white/10 shadow-2xl hover:border-cyan-500/40 hover:shadow-cyan-500/10 flex flex-col w-full">
                
                <!-- Barra superior de la tarjeta -->
                <div class="flex items-center px-4 py-2 border-b border-white/10 bg-white/[0.02]">
                  <div class="flex gap-1.5">
                    <div class="w-2.5 h-2.5 rounded-full bg-red-500 shadow-sm"></div>
                    <div class="w-2.5 h-2.5 rounded-full bg-yellow-500 shadow-sm"></div>
                    <div class="w-2.5 h-2.5 rounded-full bg-green-500 shadow-sm"></div>
                  </div>
                  <div class="mx-auto text-[11px] font-mono text-slate-500 truncate">
                    {project.title.toLowerCase().replace(/\s+/g, '-')}.config
                  </div>
                </div>

                <!-- Imagen -->
                <div class="relative overflow-hidden border-b border-white/10">
                  <div class={`absolute inset-0 bg-gradient-to-br ${project.gradient} opacity-30 z-10 pointer-events-none`} />
                  <img
                    src={project.image.src}
                    alt={project.title}
                    class="w-full h-48 object-cover group-hover:scale-105 transition-transform duration-700 opacity-90"
                  />
                  <div class="absolute top-3 right-3 z-20">
                    <span class="bg-black/70 text-cyan-400 border border-white/10 backdrop-blur-md px-3 py-1 rounded-md text-xs font-mono">
                      {project.category}
                    </span>
                  </div>
                </div>

                <!-- Cuerpo -->
                <div class="p-6 space-y-5 flex-1 flex flex-col justify-between bg-[#0A0A0A]">
                  <div class="space-y-3">
                    <h3 class="text-xl font-bold text-white group-hover:text-cyan-400 transition-colors flex items-center gap-2">
                      <span class="text-purple-400 font-mono text-sm">#</span> {project.title}
                    </h3>
                    <p class="text-stone-400 text-sm leading-relaxed font-sans">
                      {project.description}
                    </p>
                  </div>

                  <div class="space-y-4 pt-4 border-t border-white/5">
                    <div class="grid grid-cols-3 gap-2 py-2 bg-white/[0.02] rounded-lg border border-white/5 px-2">
                      {Object.entries(project.metrics).map(([key, value]) => (
                        <div class="text-center">
                          <div class="text-xs font-mono font-bold text-emerald-400 truncate">{value}</div>
                          <div class="text-[10px] text-stone-500 uppercase font-mono tracking-wider">{key}</div>
                        </div>
                      ))}
                    </div>

                    <div class="flex flex-wrap gap-1.5">
                      {project.tech.map((tech) => (
                        <span class="text-xs font-mono bg-[#09090B] border border-white/10 text-slate-300 px-2.5 py-1 rounded">
                          '{tech}'
                        </span>
                      ))}
                    </div>
                  </div>

                  <div class="pt-4">
                    <a
                      class="w-full font-mono bg-white/5 border border-white/10 hover:bg-cyan-500/10 hover:border-cyan-500/30 text-cyan-400 py-2.5 px-4 rounded-lg text-xs flex items-center justify-center gap-2 transition-all duration-300 group/btn"
                      href={project.url}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      <span>./run_demo --live</span>
                      <svg class="w-3.5 h-3.5 transition-transform duration-300 group-hover/btn:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                      </svg>
                    </a>
                  </div>

                </div>
              </div>
            </div>
          ))
        }
      </div>

      <!-- Resto de proyectos ocultos inicialmente -->
      {
        olderProjects.length > 0 && (
          <div
            id="more-projects"
            class="hidden space-y-8 opacity-0 transition-all duration-700"
          >
            <div class="grid lg:grid-cols-3 gap-8">
              {
                olderProjects.map((project, index) => (
                  <div class="animate-on-scroll flex">
                    <div class="relative group hover:-translate-y-2 transition-all duration-500 overflow-hidden rounded-xl bg-[#09090B] border border-white/10 shadow-2xl hover:border-cyan-500/40 hover:shadow-cyan-500/10 flex flex-col w-full">
                      
                      <div class="flex items-center px-4 py-2 border-b border-white/10 bg-white/[0.02]">
                        <div class="flex gap-1.5">
                          <div class="w-2.5 h-2.5 rounded-full bg-red-500 shadow-sm"></div>
                          <div class="w-2.5 h-2.5 rounded-full bg-yellow-500 shadow-sm"></div>
                          <div class="w-2.5 h-2.5 rounded-full bg-green-500 shadow-sm"></div>
                        </div>
                        <div class="mx-auto text-[11px] font-mono text-slate-500 truncate">
                          {project.title.toLowerCase().replace(/\s+/g, '-')}.config
                        </div>
                      </div>

                      <div class="relative overflow-hidden border-b border-white/10">
                        <div class={`absolute inset-0 bg-gradient-to-br ${project.gradient} opacity-30 z-10 pointer-events-none`} />
                        <img
                          src={project.image.src}
                          alt={project.title}
                          class="w-full h-48 object-cover group-hover:scale-105 transition-transform duration-700 opacity-90"
                        />
                        <div class="absolute top-3 right-3 z-20">
                          <span class="bg-black/70 text-cyan-400 border border-white/10 backdrop-blur-md px-3 py-1 rounded-md text-xs font-mono">
                            {project.category}
                          </span>
                        </div>
                      </div>

                      <div class="p-6 space-y-5 flex-1 flex flex-col justify-between bg-[#0A0A0A]">
                        <div class="space-y-3">
                          <h3 class="text-xl font-bold text-white group-hover:text-cyan-400 transition-colors flex items-center gap-2">
                            <span class="text-purple-400 font-mono text-sm">#</span> {project.title}
                          </h3>
                          <p class="text-stone-400 text-sm leading-relaxed font-sans">
                            {project.description}
                          </p>
                        </div>

                        <div class="space-y-4 pt-4 border-t border-white/5">
                          <div class="grid grid-cols-3 gap-2 py-2 bg-white/[0.02] rounded-lg border border-white/5 px-2">
                            {Object.entries(project.metrics).map(([key, value]) => (
                              <div class="text-center">
                                <div class="text-xs font-mono font-bold text-emerald-400 truncate">{value}</div>
                                <div class="text-[10px] text-stone-500 uppercase font-mono tracking-wider">{key}</div>
                              </div>
                            ))}
                          </div>

                          <div class="flex flex-wrap gap-1.5">
                            {project.tech.map((tech) => (
                              <span class="text-xs font-mono bg-[#09090B] border border-white/10 text-slate-300 px-2.5 py-1 rounded">
                                '{tech}'
                              </span>
                            ))}
                          </div>
                        </div>

                        <div class="pt-4">
                          <a
                            class="w-full font-mono bg-white/5 border border-white/10 hover:bg-cyan-500/10 hover:border-cyan-500/30 text-cyan-400 py-2.5 px-4 rounded-lg text-xs flex items-center justify-center gap-2 transition-all duration-300 group/btn"
                            href={project.url}
                            target="_blank"
                            rel="noopener noreferrer"
                          >
                            <span>./run_demo --live</span>
                            <svg class="w-3.5 h-3.5 transition-transform duration-300 group-hover/btn:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                            </svg>
                          </a>
                        </div>

                      </div>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        )
      }

      <!-- Botón Ver más / Ver menos -->
      {
        allProjects.length > 3 && (
          <div class="text-center mt-12">
            <button
              id="btn-show-more-projects"
              class="group relative inline-flex items-center gap-2 px-8 py-4 bg-[#09090B] border border-white/10 rounded-xl text-white font-mono text-sm hover:border-cyan-500/40 hover:text-cyan-400 transition-all duration-300 shadow-xl"
            >
              <span id="btn-projects-text">./carga_mas_proyectos.sh</span>
              <svg
                id="btn-projects-icon"
                class="w-4 h-4 transition-transform duration-300 group-hover:translate-y-0.5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
          </div>
        )
      }

    </div>
  </div>
</section>

<script>
  const btnProjects = document.getElementById("btn-show-more-projects");
  const containerProjects = document.getElementById("more-projects");
  const btnProjectsText = document.getElementById("btn-projects-text");
  const btnProjectsIcon = document.getElementById("btn-projects-icon");

  btnProjects?.addEventListener("click", () => {
    const isHidden = containerProjects.classList.contains("hidden");

    if (isHidden) {
      containerProjects.classList.remove("hidden");
      setTimeout(() => {
        containerProjects.classList.add("opacity-100");
        containerProjects.classList.remove("opacity-0");
      }, 10);
      btnProjectsText.innerText = "./collapse_projects.sh";
      btnProjectsIcon.style.transform = "rotate(180deg)";
    } else {
      containerProjects.classList.add("opacity-0");
      setTimeout(() => {
        containerProjects.classList.add("hidden");
        document.getElementById("projects").scrollIntoView({ behavior: "smooth" });
      }, 500);
      btnProjectsText.innerText = "./load_more_projects.sh";
      btnProjectsIcon.style.transform = "rotate(0deg)";
    }
  });
</script>