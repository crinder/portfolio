---
import { data } from "@/data/projects.js";

const projects = data.projects;
---

<section id="projects" class="relative z-10 px-6">
  <div class="max-w-7xl mx-auto">
    <div class="animate-on-scroll text-center mb-16">
      <h2 class="text-4xl md:text-5xl font-bold mb-6">
        <span
          class="bg-gradient-to-r from-white to-gray-300 bg-clip-text text-transparent"
        >
          Proyectos Destacados
        </span>
      </h2>
      <div
        class="w-24 h-1 bg-gradient-to-r from-purple-400 to-pink-400 mx-auto mb-8"
      >
      </div>
      <p class="text-xl text-white/70 max-w-2xl mx-auto">
        Una sección de mis trabajos más creativos e innovadores
      </p>
    </div>

    <div class="grid lg:grid-cols-3 gap-8">
      {
        projects.map((project, index) => (
          <div
            class="animate-on-scroll"
            style={`animation-delay: ${index * 0.2}s;`}
          >
            <div
              class="floating-element"
              style={`animation-delay: ${index * 0.3}s;`}
            >
              <div class="relative group hover:-translate-y-2 transition-all duration-500 overflow-hidden rounded-[2rem] bg-gradient-to-b from-white/[0.06] to-transparent border-t border-white/[0.1] shadow-2xl hover:shadow-purple-500/20">
                <div class="relative">
                  <div
                    class={`absolute inset-0 bg-gradient-to-br ${project.gradient} opacity-50`}
                  />
                  <img
                    src={project.image.src}
                    alt={project.title}
                    class="w-full h-48 object-cover"
                  />
                  <div class="absolute top-4 right-4">
                    <span
                      class={`bg-white/20 text-${project.color}  border border-white/30 backdrop-blur-sm px-3 py-1 rounded-full text-xs`}
                    >
                      {project.category}
                    </span>
                  </div>
                </div>

                <div class="p-6 space-y-4">
                  <h3 class="text-xl font-bold text-white group-hover:text-purple-300 transition-colors">
                    {project.title}
                  </h3>
                  <p class="text-white/70 text-sm leading-relaxed">
                    {project.description}
                  </p>

                  <div class="grid grid-cols-3 gap-4 py-4">
                    {Object.entries(project.metrics).map(([key, value]) => (
                      <div class="text-center">
                        <div class="text-lg font-bold text-white">{value}</div>
                        <div class="text-xs text-white/60 capitalize">
                          {key}
                        </div>
                      </div>
                    ))}
                  </div>

                  <div class="flex flex-wrap gap-2 mb-4">
                    {project.tech.map((tech) => (
                      <span class="text-xs bg-white/5 border border-white/20 text-white/80 px-2 py-1 rounded">
                        {tech}
                      </span>
                    ))}
                  </div>

                  <div class="flex gap-3">
                    {/*  <button class="text-white hover:bg-white/10 flex-1 py-2 px-4 rounded-lg transition-colors flex items-center justify-center text-sm">
                    <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M12.316 3.051a1 1 0 01.633 1.265l-4 12a1 1 0 11-1.898-.632l4-12a1 1 0 011.265-.633zM5.707 6.293a1 1 0 010 1.414L3.414 10l2.293 2.293a1 1 0 11-1.414 1.414l-3-3a1 1 0 010-1.414l3-3a1 1 0 011.414 0zm8.586 0a1 1 0 011.414 0l3 3a1 1 0 010 1.414l-3 3a1 1 0 11-1.414-1.414L16.586 10l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                    </svg>
                    Code
                  </button>*/}
                    <a
                      class="bg-gradient-to-r from-purple-500 to-pink-500 flex-1 py-2 px-4 rounded-lg text-sm flex items-center justify-center hover:from-purple-600 hover:to-pink-600 transition-all"
                      href={project.url}
                      target="_blank"
                    >
                      <svg
                        class="w-4 h-4 mr-2"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                        />
                      </svg>
                      Prueba
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
