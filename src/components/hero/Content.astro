---
import img from "@/img/avatar.jpeg";
import Icon from "@/components/general/Icon.astro";
---

<section
  id="home"
  class="min-h-screen flex items-center justify-center relative z-10 px-6 py-20"
>
  <div class="max-w-7xl mx-auto w-full">
    <div class="flex flex-col md:flex-row items-center justify-between gap-12">
      <div class="flex-1 text-left">
        <h1 class="text-5xl md:text-7xl font-bold mb-6">
          Hola, soy <span
            class="bg-gradient-to-r from-purple-400 to-pink-500 bg-clip-text text-transparent"
            >Criss</span
          >
        </h1>

        <!-- Bloque de propuesta de valor tipo terminal output -->
        <div
          class="font-mono text-sm mb-6 bg-[#09090b] border border-white/10 rounded-lg p-4 space-y-1.5 max-w-xl"
        >
          <p>
            <span class="text-white/30 select-none mr-2">›</span>
            <span class="text-white/50">experiencia</span>
            <span class="text-white/30"> · </span>
            <span class="text-emerald-400">10+ años</span>
            <span class="text-white/50">Oracle</span>
          </p>
          <p>
            <span class="text-white/30 select-none mr-2">›</span>
            <span class="text-white/50">frontend</span>
            <span class="text-white/30"> · </span>
            <span class="text-cyan-400">3+ años</span>
            <span class="text-white/50"> React / Node</span>
          </p>
          <p class="flex items-center gap-2">
            <span class="text-white/30 select-none mr-2">›</span>
            <span class="text-white/50">status</span>
            <span class="text-white/30"> · </span>
            <span class="relative flex h-2 w-2">
              <span
                class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"
              ></span>
              <span
                class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"
              ></span>
            </span>
            <span class="text-emerald-400">Disponible para proyectos</span>
          </p>
        </div>

        <p
          class="text-lg md:text-xl text-gray-300 max-w-xl leading-relaxed mb-8"
        >
          Construyo sitios web que ayudan a simplificar las cosas. Mi prioridad
          es crear soluciones que sean útiles para el usuario, buscando siempre
          el equilibrio entre un alto rendimiento y un diseño funcional sin
          añadir complicaciones innecesarias.
        </p>

        <div class="flex flex-wrap gap-4">
          <a
            href="/cv1.pdf"
            download
            class="group relative inline-flex items-center gap-2.5 px-6 py-3 bg-emerald-500 hover:bg-emerald-400 text-black font-mono font-bold text-sm rounded-lg transition-all duration-300 shadow-[0_0_20px_rgba(52,211,153,0.3)] hover:shadow-[0_0_30px_rgba(52,211,153,0.5)] hover:-translate-y-0.5"
          >
            <Icon name="download" class="w-4 h-4" />
            ./download --cv
          </a>
          <a
            href="#projects"
            class="group inline-flex items-center gap-2.5 px-6 py-3 bg-transparent border border-white/20 hover:border-cyan-500/50 text-white/70 hover:text-cyan-400 font-mono text-sm rounded-lg transition-all duration-300 hover:-translate-y-0.5"
          >
            ./view_projects
            <Icon
              name="arrow-down"
              class="w-4 h-4 transition-transform duration-300 group-hover:translate-y-0.5"
            />
          </a>
        </div>
      </div>

      <div class="relative group">
        <div
          class="absolute -inset-1 bg-gradient-to-r from-purple-600 to-pink-600 rounded-full blur opacity-25 group-hover:opacity-50 transition duration-700 ease-out"
        >
        </div>
        <div
          class="relative w-64 h-64 md:w-80 md:h-80 rounded-full overflow-hidden border-2 border-white/10 shadow-2xl"
        >
          <img
            src={img.src}
            alt="Crinderson"
            class="w-full h-full object-cover"
          />
        </div>
      </div>
    </div>
  </div>
</section>
