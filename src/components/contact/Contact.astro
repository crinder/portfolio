---

---

<section id="contact" class="py-20 relative z-10 px-6">
  <div class="max-w-4xl mx-auto text-center">
    <!-- Texto -->
    <div class="animate-on-scroll mb-16">
      <h2 class="text-4xl md:text-5xl font-bold mb-6">
        <span class="bg-gradient-to-r from-white to-gray-300 bg-clip-text text-transparent">
          Gracias por pasearte por mi portafolio
        </span>
      </h2>

      <div class="w-24 h-1 bg-gradient-to-r from-purple-400 to-pink-400 mx-auto mb-8">
      </div>

      <p class="text-xl text-white/70 max-w-2xl mx-auto">
        Si algo te llamó la atención aunque no sepas exactamente qué, escríbeme.
        A veces las mejores ideas empiezan con una simple curiosidad.
      </p>

      <p class="text-xl text-white/70 max-w-2xl mx-auto mt-5">
        Y si no te llamó nada la atención… ¡wow! Eso también es un logro 😄
      </p>
    </div>

    <!-- Card -->
    <div class="floating-element animate-on-scroll">
      <div
        class="glass-card-card p-8 md:p-12 rounded-2xl
               border border-white/5 bg-white/5 backdrop-blur-sm
               transition-transform duration-500 ease-out
               translate-y-0.5 hover:translate-y-0"
      >
        <div class="grid md:grid-cols-3 gap-8 mb-4">
          <!-- Email -->
          <div class="relative group cursor-pointer">
            <div class="absolute -inset-0.5 rounded-2xl blur
                     bg-gradient-to-r from-blue-400 to-cyan-400
                     opacity-0 group-hover:opacity-15
                     transition-opacity duration-500">
            </div>

            <div class="relative text-center p-6 rounded-2xl
                     transition-colors duration-500
                     group-hover:bg-white/5">
              <div class="w-16 h-16 bg-gradient-to-r from-blue-400 to-cyan-400
                       rounded-2xl flex items-center justify-center
                       mx-auto mb-4
                       transition-shadow duration-500
                       shadow-md shadow-blue-500/20
                       group-hover:shadow-blue-500/30">
                <svg width="28" height="28">
                  <use xlink:href="sprite.svg#icon-email"></use>
                </svg>
              </div>

              <h3 class="text-white font-semibold mb-2">Email</h3>
              <p class="text-white/70 text-sm">crinderson@gmail.com</p>
            </div>
          </div>

          <!-- LinkedIn -->
          <div class="relative group cursor-pointer">
            <div class="absolute -inset-0.5 rounded-2xl blur
                     bg-gradient-to-r from-purple-400 to-pink-400
                     opacity-0 group-hover:opacity-15
                     transition-opacity duration-500">
            </div>

            <div class="relative text-center p-6 rounded-2xl
                     transition-colors duration-500
                     group-hover:bg-white/5">
              <div
                class="w-16 h-16 bg-gradient-to-r from-purple-400 to-pink-400
                       rounded-2xl flex items-center justify-center
                       mx-auto mb-4
                       transition-shadow duration-500
                       shadow-md shadow-purple-500/20
                       group-hover:shadow-purple-500/30">
                <svg width="28" height="28">
                  <use xlink:href="sprite.svg#icon-linkedin"></use>
                </svg>
              </div>

              <h3 class="text-white font-semibold mb-2">LinkedIn</h3>
              <p class="text-white/70 text-sm">Crinderson Ayala</p>
            </div>
          </div>

          <!-- GitHub -->
          <div class="relative group cursor-pointer">
            <div class="absolute -inset-0.5 rounded-2xl blur
                     bg-gradient-to-r from-green-400 to-emerald-400
                     opacity-0 group-hover:opacity-15
                     transition-opacity duration-500">
            </div>

            <div class="relative text-center p-6 rounded-2xl
                     transition-colors duration-500
                     group-hover:bg-white/5">
              <div class="w-16 h-16 bg-gradient-to-r from-green-400 to-emerald-400
                       rounded-2xl flex items-center justify-center
                       mx-auto mb-4
                       transition-shadow duration-500
                       shadow-md shadow-emerald-500/20
                       group-hover:shadow-emerald-500/30">
                  <svg width="28" height="28">
                    <use xlink:href="sprite.svg#icon-github"></use>
                  </svg>
              </div>

              <h3 class="text-white font-semibold mb-2">GitHub</h3>
              <p class="text-white/70 text-sm">Crissdev9</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
